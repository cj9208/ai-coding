# OCR runner — CPU profile.
#
# One-shot container around `ocr-backend parse` (see src/ocr_backend/cli.py):
# the image carries the code, the Poppler system dep pdf2image needs, and the
# locked Python environment for the CPU OCR stack. Model weights are NOT baked
# in — mount them (see docker/ocr/compose.yaml). Docs:
# docs/service-containerization-exploration.md.
#
#   docker compose -f docker/ocr/compose.yaml --profile cpu build ocr-cpu
#   docker compose -f docker/ocr/compose.yaml --profile cpu run --rm \
#     ocr-cpu parse /work/in/scan.pdf --out /work/out --device cpu
#
# This image is linux/amd64-only (Paddle's supported wheel platform).

FROM python:3.12-slim-bookworm

# pdf2image shells out to pdftoppm/pdftocairo from Poppler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Lockfile + sources first, code last: the multi-GB Paddle layer stays cached
# across ordinary src/ edits. `uv sync` installs the project itself (and its
# `ocr-backend` console script) editable, per [tool.uv] package = true.
COPY pyproject.toml uv.lock readme.md ./
RUN uv sync --locked --no-install-project --extra ocr --extra paddle-cpu

COPY src/ src/
RUN uv sync --locked --extra ocr --extra paddle-cpu

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:${PATH}" \
    HOME=/work

ENTRYPOINT ["ocr-backend"]
